# Copy to .env.local for local development, and add the same values in Vercel.
# Same Supabase project as the staff app. Only the publishable/anon key, never the secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public address of this site, used for link previews on WhatsApp, Instagram and Facebook.
VITE_SITE_URL=https://your-site.vercel.app
